FROM ubuntu:24.04

# 環境変数の設定（対話型プロンプトの回避とパスの設定）
ENV DEBIAN_FRONTEND=noninteractive
ENV PATH=/opt/conda/bin:$PATH

# 必要最低限のツール、SSHサーバー、nanoのインストール
RUN apt-get update && apt-get install -y \
    openssh-server \
    iproute2 \
    iputils-ping \
    nano \
    curl \
    wget \
    bzip2 \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

# --- Miniconda3 のインストール（Apple Silicon / ARM64 対応版） ---
# --- Miniconda3 のインストール（Apple Silicon / ARM64 専用の直リンク） ---
RUN wget --quiet https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-aarch64.sh -O /tmp/miniconda.sh && \
    /bin/bash /tmp/miniconda.sh -b -p /opt/conda && \
    rm /tmp/miniconda.sh

# Condaの初期化（SSHログイン時にも自動でパスが通るように設定）
RUN /opt/conda/bin/conda init bash && \
    echo "export PATH=/opt/conda/bin:\$PATH" >> /etc/profile
# Copy requirements and install Python packages
COPY requirements.txt /tmp/requirements.txt
RUN /opt/conda/bin/pip install --no-cache-dir -r /tmp/requirements.txt && rm -f /tmp/requirements.txt

# SSHの設定（rootログインの許可とパスワード認証の有効化）
RUN mkdir /var/run/sshd
RUN echo 'root:root' | chpasswd
# パスワード認証を無効化して鍵認証を推奨（root のパスワードログインは制限）
RUN sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config \
 && sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config || true
RUN sed -i 's/^#\?UsePAM.*/UsePAM yes/' /etc/ssh/sshd_config || true

# 公開鍵を配置
COPY keys/authorized_keys /root/.ssh/authorized_keys
RUN mkdir -p /root/.ssh \
 && chown root:root /root/.ssh/authorized_keys || true \
 && chmod 700 /root/.ssh || true \
 && chmod 600 /root/.ssh/authorized_keys || true

# SSHポートの開放
EXPOSE 22

# ログイン時に自動でMinicondaのbase環境を起動する設定
RUN echo "conda activate base" >> ~/.bashrc
RUN echo "conda activate base" >> /etc/profile

# SSHサービスをフォアグラウンドで起動
CMD ["/usr/sbin/sshd", "-D"]

